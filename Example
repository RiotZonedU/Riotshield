-- Load the DrRay library from the GitHub repository Library
local RiotshieldLibrary = loadstring(game:HttpGet("https://raw.githubusercontent.com/RiotZonedU/Riotshield/refs/heads/main/Library.lua"))()

-- Create a new window and set its title and theme
local window = RiotshieldLibrary:Load("Riotshield", "Default")

-- Create the first tab with an image ID
local Autoheal = RiotshieldLibrary.newTab("Autoheal", "ImageIdHere")

-- Add elements to the first tab
Autoheal.newLabel("Hello, this is Tab 1.")
Autoheal.newToggle("Toggle", "Toggle! (prints the state)", true, function(toggleState)
    if toggleState then
        print("On")
    else
        print("Off")
    end
end)
Autoheal.newDropdown("Chunk Amount", "Select Heal Amount", {"1", "2", "3", "4", "5"}, function(selectedOption)
    print(selectedOption)
end)

-- Create the second tab with a different image ID
local tab2 = RiotshieldLibrary.newTab("Tab 2", "ImageIdLogoHere")

-- Add elements to the second tab
tab2.newLabel("Hello, this is Tab 2.")
tab2.newButton("Button", "Prints Hello!", function()
    print('Hello!')
end)
tab2.newToggle("Toggle", "Toggle! (prints the state)", true, function(toggleState)
    if toggleState then
        print("On")
    else
        print("Off")
    end
end)
tab2.newDropdown("Chunk Amount", "Select one of these options!", {"1", "2", "3", "4", "5"}, function(selectedOption)
    print(selectedOption)
end)
