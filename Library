local gui = Riotshield.new("MyGUI")

-- Add a tab
local autohealTab = gui:AddTab("Autoheal")

-- Add components to the tab
local enabledToggle = gui:AddToggle(autohealTab, "Enabled", function(state)
    print("Autoheal enabled:", state)
end)

local cpsInput = gui:AddNumberInput(autohealTab, "CPS", 1, 100, 60, function(value)
    print("CPS set to:", value)
end)

local thresholdInput = gui:AddNumberInput(autohealTab, "Threshold", 1, 100, 50, function(value)
    print("Threshold set to:", value)
end)

local chunkInput = gui:AddNumberInput(autohealTab, "Chunk", 1, 10, 3, function(value)
    print("Chunk size set to:", value)
end)

-- Add another tab
local autoPinchTab = gui:AddTab("Auto Pinch")

gui:AddToggle(autoPinchTab, "Enabled", function(state)
    print("Auto pinch enabled:", state)
end)

gui:AddNumberInput(autoPinchTab, "Delay", 0.1, 5, 0.7, function(value)
    print("Delay set to:", value)
end)

gui:AddNumberInput(autoPinchTab, "Velocity", 1, 20, 5, function(value)
    print("Velocity set to:", value)
end)

gui:AddKeybind(autoPinchTab, "Target Key", "ButtonL3", function(key)
    print("Target key set to:", key)
end)

gui:AddKeybind(autoPinchTab, "Pinch Key", "DPadRight", function(key)
    print("Pinch key set to:", key)
end)

-- Add hitbox tab
local hitboxTab = gui:AddTab("Hitbox")

gui:AddToggle(hitboxTab, "Enabled", function(state)
    print("Hitbox enabled:", state)
end)

gui:AddNumberInput(hitboxTab, "Size", 1, 20, 6, function(value)
    print("Hitbox size set to:", value)
end)

-- Add tracking tab
local trackingTab = gui:AddTab("Tracking")

gui:AddToggle(trackingTab, "Enabled", function(state)
    print("Tracking enabled:", state)
end)

gui:AddKeybind(trackingTab, "Keybind", "ButtonB", function(key)
    print("Tracking keybind set to:", key)
end)
]]

return Riotshield
