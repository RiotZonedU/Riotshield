-- Riotshield GUI Library v2.0
-- A modular, reusable GUI library for Roblox
-- Based on the labeled template structure

local Riotshield = {}
Riotshield.__index = Riotshield

-- ===============================
-- CONFIGURATION
-- ===============================

local THEME = {
    -- Colors
    BackgroundPrimary = Color3.fromRGB(42, 42, 42),    -- Main background
    BackgroundSecondary = Color3.fromRGB(46, 46, 46),  -- Input backgrounds
    BackgroundDark = Color3.fromRGB(0, 0, 0),          -- Dark overlays
    TextPrimary = Color3.fromRGB(255, 255, 255),       -- White text
    TextSecondary = Color3.fromRGB(91, 91, 91),        -- Gray text (arrows, placeholders)
    Border = Color3.fromRGB(170, 170, 170),            -- Border color
    ToggleOn = Color3.fromRGB(255, 255, 255),          -- Toggle ON state
    ToggleOff = Color3.fromRGB(42, 42, 42),            -- Toggle OFF state
    
    -- Sizes
    ButtonHeight = 30,
    SettingRowHeight = 24,
    SectionWidth = 135,
    ToggleSize = 20,
    InputWidth = 20,
    InputHeight = 15,
    
    -- Fonts
    Font = Enum.Font.Arial,
    FontSizeSmall = 10,
    FontSizeMedium = 13,
    
    -- Corners
    CornerRadiusSmall = UDim.new(0, 2),
    CornerRadiusInput = UDim.new(0, 3),
}

-- ===============================
-- UTILITY FUNCTIONS
-- ===============================

local function createCorner(instance, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = radius or THEME.CornerRadiusSmall
    corner.Parent = instance
    return corner
end

local function createPadding(instance, left)
    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, left or 5)
    padding.Parent = instance
    return padding
end

local function createListLayout(instance, direction)
    local layout = Instance.new(direction == "Vertical" and "UIListLayout" or "UIGridLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = instance
    return layout
end

-- ===============================
-- MAIN WINDOW CLASS
-- ===============================

local Window = {}
Window.__index = Window

function Riotshield.new(title: string): Window
    local self = setmetatable({}, Window)
    
    -- Create ScreenGui
    self.Gui = Instance.new("ScreenGui")
    self.Gui.Name = title .. "_GUI"
    self.Gui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
    self.Gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    
    -- Create main container (Feature Toggle Holder)
    self.MainContainer = Instance.new("Frame")
    self.MainContainer.Name = "FeatureToggleHolder"
    self.MainContainer.Parent = self.Gui
    self.MainContainer.BackgroundColor3 = THEME.BackgroundPrimary
    self.MainContainer.BorderSizePixel = 0
    self.MainContainer.Position = UDim2.new(0, 20, 0, 61)
    self.MainContainer.Size = UDim2.new(0, THEME.SectionWidth, 0, 240)
    
    createCorner(self.MainContainer)
    createListLayout(self.MainContainer, "Vertical")
    
    -- Store sections
    self.Sections = {}
    self.Tabs = {}
    
    return self
end

-- ===============================
-- TAB SECTION (COLLAPSIBLE)
-- ===============================

function Window:AddTab(name: string): table
    local tab = {
        Name = name,
        Button = nil,
        Arrow = nil,
        SettingsHolder = nil,
        SettingsButton = nil,
        SettingsTab = nil,
        Components = {}
    }
    
    -- Create main tab button (OpenTabButton)
    local button = Instance.new("TextButton")
    button.Name = name .. "Tab"
    button.Parent = self.MainContainer
    button.BackgroundColor3 = THEME.BackgroundPrimary
    button.BorderSizePixel = 0
    button.Size = UDim2.new(1, 0, 0, THEME.ButtonHeight)
    button.Font = THEME.Font
    button.Text = name
    button.TextColor3 = THEME.TextPrimary
    button.TextSize = THEME.FontSizeMedium
    button.TextWrapped = true
    button.TextXAlignment = Enum.TextXAlignment.Left
    
    createPadding(button, 10)
    
    -- Arrow indicator
    local arrow = Instance.new("TextLabel")
    arrow.Name = "Arrow"
    arrow.Parent = button
    arrow.BackgroundTransparency = 1
    arrow.Position = UDim2.new(0, 102, 0, 3)
    arrow.Size = UDim2.new(0, 15, 0, THEME.ButtonHeight - 6)
    arrow.Font = THEME.Font
    arrow.Text = ">"
    arrow.TextColor3 = THEME.TextSecondary
    arrow.TextSize = THEME.FontSizeMedium
    
    -- Settings holder (hidden container for the settings button)
    local settingsHolder = Instance.new("Frame")
    settingsHolder.Name = name .. "SettingsHolder"
    settingsHolder.Parent = button
    settingsHolder.BackgroundColor3 = THEME.BackgroundDark
    settingsHolder.BorderSizePixel = 0
    settingsHolder.Size = UDim2.new(0, THEME.SectionWidth, 0, THEME.SettingRowHeight)
    settingsHolder.Visible = false
    settingsHolder.ZIndex = 2
    
    createCorner(settingsHolder)
    
    -- Settings button that opens the actual settings tab
    local settingsButton = Instance.new("TextButton")
    settingsButton.Name = name .. "SettingsButton"
    settingsButton.Parent = settingsHolder
    settingsButton.BackgroundColor3 = THEME.BackgroundPrimary
    settingsButton.BorderSizePixel = 0
    settingsButton.Size = UDim2.new(1, 0, 0, 26)
    settingsButton.Font = THEME.Font
    settingsButton.Text = name
    settingsButton.TextColor3 = THEME.TextPrimary
    settingsButton.TextSize = THEME.FontSizeMedium
    settingsButton.TextWrapped = true
    settingsButton.TextXAlignment = Enum.TextXAlignment.Left
    
    createPadding(settingsButton, 10)
    createCorner(settingsButton)
    
    -- Arrow for settings button
    local settingsArrow = Instance.new("TextLabel")
    settingsArrow.Name = "Arrow"
    settingsArrow.Parent = settingsButton
    settingsArrow.BackgroundTransparency = 1
    settingsArrow.Position = UDim2.new(0, 105, 0, -1)
    settingsArrow.Size = UDim2.new(0, 15, 0, 24)
    settingsArrow.Font = THEME.Font
    settingsArrow.Text = ">"
    settingsArrow.TextColor3 = THEME.TextSecondary
    settingsArrow.TextSize = THEME.FontSizeMedium
    
    -- Settings tab (actual content container)
    local settingsTab = Instance.new("Frame")
    settingsTab.Name = name .. "SettingsTab"
    settingsTab.Parent = settingsButton
    settingsTab.BackgroundColor3 = THEME.BackgroundPrimary
    settingsTab.BorderSizePixel = 0
    settingsTab.Position = UDim2.new(0, -10, 0.923, 0)
    settingsTab.Size = UDim2.new(0, THEME.SectionWidth, 0, 240)
    settingsTab.Visible = false
    
    createCorner(settingsTab)
    createListLayout(settingsTab, "Vertical")
    
    -- Store references
    tab.Button = button
    tab.Arrow = arrow
    tab.SettingsHolder = settingsHolder
    tab.SettingsButton = settingsButton
    tab.SettingsArrow = settingsArrow
    tab.SettingsTab = settingsTab
    
    -- Setup click handlers
    button.MouseButton1Click:Connect(function()
        settingsHolder.Visible = not settingsHolder.Visible
        arrow.Rotation = settingsHolder.Visible and 90 or 0
    end)
    
    settingsButton.MouseButton1Click:Connect(function()
        settingsTab.Visible = not settingsTab.Visible
        settingsArrow.Rotation = settingsTab.Visible and 90 or 0
    end)
    
    self.Tabs[name] = tab
    return tab
end

-- ===============================
-- COMPONENT: TOGGLE
-- ===============================

function Window:AddToggle(tab: table, name: string, callback: (boolean) -> ())
    local toggle = {
        Name = name,
        State = false,
        Button = nil,
        Callback = callback
    }
    
    -- Create toggle container frame
    local container = Instance.new("Frame")
    container.Name = name .. "Toggle"
    container.Parent = tab.SettingsTab
    container.BackgroundColor3 = THEME.BackgroundPrimary
    container.BorderSizePixel = 0
    container.Size = UDim2.new(0, THEME.SectionWidth, 0, THEME.SettingRowHeight)
    
    createPadding(container, 5)
    
    -- Title label
    local title = Instance.new("TextLabel")
    title.Name = "Title"
    title.Parent = container
    title.BackgroundTransparency = 1
    title.Position = UDim2.new(0, 0, 0, 3)
    title.Size = UDim2.new(0, 0, 0, 20)
    title.Font = THEME.Font
    title.Text = name
    title.TextColor3 = THEME.TextPrimary
    title.TextSize = THEME.FontSizeSmall
    title.TextXAlignment = Enum.TextXAlignment.Left
    
    -- Toggle button
    local toggleButton = Instance.new("TextButton")
    toggleButton.Name = "ToggleButton"
    toggleButton.Parent = container
    toggleButton.BackgroundColor3 = THEME.ToggleOff
    toggleButton.BorderSizePixel = 0
    toggleButton.Position = UDim2.new(0, 100, 0, 5)
    toggleButton.Size = UDim2.new(0, THEME.ToggleSize, 0, THEME.InputHeight)
    toggleButton.Font = THEME.Font
    toggleButton.Text = ""
    toggleButton.TextColor3 = Color3.fromRGB(0, 0, 0)
    
    createCorner(toggleButton, THEME.CornerRadiusInput)
    
    -- Click handler
    toggleButton.Activated:Connect(function()
        toggle.State = not toggle.State
        toggleButton.BackgroundColor3 = toggle.State and THEME.ToggleOn or THEME.ToggleOff
        
        if toggle.Callback then
            toggle.Callback(toggle.State)
        end
    end)
    
    toggle.Button = toggleButton
    return toggle
end

-- ===============================
-- COMPONENT: TEXTBOX
-- ===============================

function Window:AddTextbox(tab: table, name: string, placeholder: string, defaultValue: string, callback: (string) -> ())
    local textbox = {
        Name = name,
        Value = defaultValue,
        Instance = nil,
        Callback = callback
    }
    
    -- Create container frame
    local container = Instance.new("Frame")
    container.Name = name .. "Textbox"
    container.Parent = tab.SettingsTab
    container.BackgroundColor3 = THEME.BackgroundPrimary
    container.BorderSizePixel = 0
    container.Size = UDim2.new(0, THEME.SectionWidth, 0, THEME.SettingRowHeight)
    
    createPadding(container, 5)
    
    -- Title label
    local title = Instance.new("TextLabel")
    title.Name = "Title"
    title.Parent = container
    title.BackgroundTransparency = 1
    title.Position = UDim2.new(0, 0, 0, 3)
    title.Size = UDim2.new(0, 0, 0, 20)
    title.Font = THEME.Font
    title.Text = name
    title.TextColor3 = THEME.TextPrimary
    title.TextSize = THEME.FontSizeSmall
    title.TextXAlignment = Enum.TextXAlignment.Left
    
    -- Textbox input
    local input = Instance.new("TextBox")
    input.Name = "Input"
    input.Parent = container
    input.BackgroundColor3 = THEME.BackgroundSecondary
    input.BackgroundTransparency = 1
    input.BorderSizePixel = 0
    input.Position = UDim2.new(0, 100, 0, 5)
    input.Size = UDim2.new(0, THEME.InputWidth, 0, THEME.InputHeight)
    input.ClearTextOnFocus = false
    input.Font = THEME.Font
    input.PlaceholderText = placeholder or "Enter value"
    input.Text = defaultValue or ""
    input.TextColor3 = THEME.TextPrimary
    input.TextSize = THEME.FontSizeSmall
    input.TextWrapped = true
    
    createCorner(input, THEME.CornerRadiusInput)
    
    -- Input handler
    input:GetPropertyChangedSignal("Text"):Connect(function()
        textbox.Value = input.Text
        if textbox.Callback then
            textbox.Callback(input.Text)
        end
    end)
    
    textbox.Instance = input
    return textbox
end

-- ===============================
-- COMPONENT: NUMBER INPUT
-- ===============================

function Window:AddNumberInput(tab: table, name: string, min: number, max: number, defaultValue: number, callback: (number) -> ())
    local numberInput = {
        Name = name,
        Value = defaultValue,
        Instance = nil,
        Callback = callback
    }
    
    local container = Instance.new("Frame")
    container.Name = name .. "NumberInput"
    container.Parent = tab.SettingsTab
    container.BackgroundColor3 = THEME.BackgroundPrimary
    container.BorderSizePixel = 0
    container.Size = UDim2.new(0, THEME.SectionWidth, 0, THEME.SettingRowHeight)
    
    createPadding(container, 5)
    
    local title = Instance.new("TextLabel")
    title.Name = "Title"
    title.Parent = container
    title.BackgroundTransparency = 1
    title.Position = UDim2.new(0, 0, 0, 3)
    title.Size = UDim2.new(0, 0, 0, 20)
    title.Font = THEME.Font
    title.Text = name
    title.TextColor3 = THEME.TextPrimary
    title.TextSize = THEME.FontSizeSmall
    title.TextXAlignment = Enum.TextXAlignment.Left
    
    local input = Instance.new("TextBox")
    input.Name = "Input"
    input.Parent = container
    input.BackgroundColor3 = THEME.BackgroundSecondary
    input.BackgroundTransparency = 1
    input.BorderSizePixel = 0
    input.Position = UDim2.new(0, 100, 0, 5)
    input.Size = UDim2.new(0, THEME.InputWidth, 0, THEME.InputHeight)
    input.ClearTextOnFocus = false
    input.Font = THEME.Font
    input.PlaceholderText = tostring(defaultValue or min)
    input.Text = tostring(defaultValue or min)
    input.TextColor3 = THEME.TextPrimary
    input.TextSize = THEME.FontSizeSmall
    input.TextWrapped = true
    
    createCorner(input, THEME.CornerRadiusInput)
    
    input:GetPropertyChangedSignal("Text"):Connect(function()
        local num = tonumber(input.Text)
        if num then
            num = math.clamp(num, min, max)
            numberInput.Value = num
            input.Text = tostring(num)
            if numberInput.Callback then
                numberInput.Callback(num)
            end
        end
    end)
    
    numberInput.Instance = input
    return numberInput
end

